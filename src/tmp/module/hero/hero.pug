section.tr__hero
    .container
        .tr__hero--inner
            .tr__hero--bg
                img(src="img/hero/hero.jpg" alt="" width="1530" height="619" fetchpriority="high" decoding="async")
            .tr__hero--content
                h1.tr__hero--title Европейская терраса
                    br
                    | для вашего дома
                p.tr__hero--subtitle Террасная композитная доска в Москве
                +modalButton('Вызвать на замер', 'callback', 'tr__hero--button')
